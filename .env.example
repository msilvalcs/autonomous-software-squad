LLM_PROVIDER=mock
LLM_MODEL=
# JSON opcional para sobrescrever provider, modelo e reasoning por complexidade/persona.
# Providers diferentes de "codex" precisam existir em ~/.codex/config.toml.
# MODEL_ROUTING_CONFIG={"MEDIUM":{"PO":{"provider":"anthropic","model":"<opus-model-id>","reasoningEffort":"medium"},"DEV":{"provider":"codex","model":"gpt-5.6-luna","reasoningEffort":"low"},"QA":{"provider":"anthropic","model":"<sonnet-model-id>","reasoningEffort":"high"}}}
MODEL_ROUTING_CONFIG=
LLM_API_KEY=
GITHUB_ISSUES_ENABLED=false
GITHUB_REPOSITORY=msilvalcs/autonomous-software-squad
GITHUB_TOKEN=
EXECUTION_MODE=local
DOCKER_RUNNER_IMAGE=autonomous-squad-runner:local
# Mínimos permitidos: local, docker ou microvm. O backend selecionado nunca
# sofre fallback para um nível inferior.
MINIMUM_ISOLATION_LOW=local
MINIMUM_ISOLATION_MEDIUM=local
MINIMUM_ISOLATION_HIGH=local
# Gate experimental. EXECUTION_MODE=microvm bloqueia até o adaptador ser
# homologado, mesmo quando todos os caminhos abaixo estiverem válidos.
FIRECRACKER_BINARY=
FIRECRACKER_JAILER_BINARY=
FIRECRACKER_KERNEL_IMAGE=
FIRECRACKER_ROOTFS_IMAGE=
MAX_QA_ATTEMPTS=3
GENERATED_PROJECTS_PATH=./generated-projects
PORT=3000
